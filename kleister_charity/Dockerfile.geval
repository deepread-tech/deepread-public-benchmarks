# GEval (official Kleister-Charity scorer), built from the pinned release tag.
# gonito.net, which hosted the prebuilt binary, is unreachable as of 2026-10-01.
FROM haskell:9.0.2-buster AS build
# Debian buster is end-of-life: its packages now live on archive.debian.org.
RUN sed -i -e "s|deb.debian.org|archive.debian.org|g" -e "/buster-updates/d" -e "s|security.debian.org/debian-security|archive.debian.org/debian-security|g" /etc/apt/sources.list
RUN apt-get update && apt-get install -y --no-install-recommends \
      git pkg-config libcairo2-dev libpango1.0-dev libglib2.0-dev zlib1g-dev libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch 1.14.2.0 https://gitlab.com/filipg/geval.git /geval
WORKDIR /geval
RUN stack config set system-ghc --global true && stack build --system-ghc --copy-bins --local-bin-path /out

FROM debian:buster-slim
RUN sed -i -e "s|deb.debian.org|archive.debian.org|g" -e "/buster-updates/d" -e "s|security.debian.org/debian-security|archive.debian.org/debian-security|g" /etc/apt/sources.list
RUN apt-get update && apt-get install -y --no-install-recommends libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libglib2.0-0 zlib1g libsqlite3-0 libgmp10 libnuma1 libffi6 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/geval /usr/local/bin/geval
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
ENTRYPOINT ["geval"]
